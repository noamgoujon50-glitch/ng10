NODE_ENV=production

# Local test port. On Render/Railway, the host can provide PORT automatically.
PORT=8787
VALHALLA_DATA_DIR=/app/data
VALHALLA_SERVER_SECRET=change-this-long-random-secret-before-production

# Optional for later. Leave empty while the app uses the local coach fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Challenge proof metadata retention in hours.
VALHALLA_PROOF_RETENTION_HOURS=24
